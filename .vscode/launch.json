{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run StudyHub",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bRunning on (https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}